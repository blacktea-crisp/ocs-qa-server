# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
# 管理接口鉴权 Token（管理台需在 Header X-Admin-Token 中携带）；留空则不校验
ADMIN_TOKEN=changeme
# 允许的跨域来源（管理台地址），逗号分隔；* 表示全部
CORS_ORIGINS=*

# ===== 数据库 =====
DB_PATH=data/ocs_qa.db

# ===== 大模型（OpenAI 兼容协议；本地/云端改这里即可切换）=====
# 例：本地 Ollama: http://127.0.0.1:11434/v1  ；云端: https://api.openai.com/v1
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# 识图（多模态）模型；视觉能力需模型支持图片
VISION_MODEL=qwen2.5vl:7b
LLM_TIMEOUT=60

# ===== 答案信任策略默认值（可被 OCS 请求参数 / Web 设置 三级覆盖）=====
# trusted_only | prefer_trusted | allow_candidate
DEFAULT_ANSWER_TRUST=prefer_trusted

# ===== 行为开关 =====
# 是否把每次请求的题都入库
STORE_EVERY_REQUEST=true
# 未命中走大模型
ENABLE_LLM=true
# 含图时识图
ENABLE_VISION=true
# 相似匹配阈值（0-1）
SIMILARITY_THRESHOLD=0.75
